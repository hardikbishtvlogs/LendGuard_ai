# Development defaults. Copy to .env and replace every production secret.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://lendguard:lendguard@db:5432/lendguard
POSTGRES_DB=lendguard
POSTGRES_USER=lendguard
POSTGRES_PASSWORD=replace-with-a-unique-database-password
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3100
TRUSTED_HOSTS=localhost,127.0.0.1
MODEL_PATH=/ml/artifacts/model.joblib
POWERBI_PUSH_URL=
POWERBI_EMBED_URL=
